# --------------------------------------------------------------------------
# AURUM SIGNAL ENGINE M60 — configurazione
# Copia in `.env`:  cp .env.example .env
# Le variabili gia' presenti nell'ambiente hanno la precedenza su questo file.
# --------------------------------------------------------------------------

# --- sorgente dati -------------------------------------------------------
# Adapter provati in ordine: il primo che si connette vince.
MARKET_ADAPTERS=twelvedata,finnhub,exchangerate

# Chiavi gratuite (registrazione richiesta). Senza almeno una di queste il
# comando `run` non parte: usa `run --simulate` per provare il sistema.
#   twelvedata.com/pricing  ->  livello gratuito
#   finnhub.io/pricing      ->  livello gratuito, manda il timestamp
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# --- economia ------------------------------------------------------------
# Il payout del TUO broker. Determina il pareggio: 1/(1+payout).
# Con 0.80 servono piu' del 55,56% di vittorie per non perdere.
PAYOUT=0.80
VIRTUAL_CAPITAL=500
VIRTUAL_STAKE=25

# --- tempi ---------------------------------------------------------------
HORIZON_SECONDS=60
SIGNAL_LEAD_SECONDS=30
SIGNAL_FREEZE_SECONDS=5

# --- notifiche (facoltative) ---------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- interfaccia ---------------------------------------------------------
HTTP_HOST=127.0.0.1
HTTP_PORT=8100

# --- database ------------------------------------------------------------
DATABASE_PATH=aurum_m60.db
