# AURUM EDGE LAB — environment overrides.
#
# Nothing here is a secret, and nothing here can become one. This system reads
# public market data only: there is no API key, no signing secret and no
# endpoint that would accept them.
#
# Every value in config.yaml can be overridden from the environment. Two forms
# work and mean the same thing:
#
#     AURUM_SET__market__replay_speed=8       # any shell
#     env 'AURUM_SET__market.replay_speed=8'  # dotted form needs `env`, because
#                                             # a shell identifier cannot contain
#                                             # a dot
#
# The aliases below are the common knobs, spelled more conveniently.

# ---------------------------------------------------------------- application

# development | production. Production refuses a replay feed outright.
AURUM_ENV=development
AURUM_LOG_LEVEL=INFO
AURUM_LOG_JSON=false
AURUM_DATA_DIR=./data

# ------------------------------------------------------------------------ api

AURUM_API_HOST=127.0.0.1
AURUM_API_PORT=8002

# ---------------------------------------------------------------------- feed

# live | replay
AURUM_FEED=live

# bybit_linear | bybit_linear_testnet | binance_usdm | binance_usdm_testnet
AURUM_VENUE=bybit_linear

# Endpoint routing. LEAVE THESE EMPTY unless you need a specific host: empty
# means "use the selected venue's defaults", which is what stops a Bybit run
# from keeping Binance's hosts. Check the venue's current documentation before a
# live run — routing has changed before on both venues, which is why these are
# configuration rather than constants. `main.py diagnose` verifies them and
# reports the exact URL that failed.
AURUM_REST_BASE=
AURUM_WS_BASE=

# Bybit V5:     https://api.bybit.com          wss://stream.bybit.com
# Bybit test:   https://api-testnet.bybit.com  wss://stream-testnet.bybit.com
# Binance USDM: https://fapi.binance.com       wss://fstream.binance.com
# Binance test: https://testnet.binancefuture.com  wss://stream.binancefuture.com

# NOTE: there is deliberately no API key variable here, for either venue. This
# system reads public market data only; it has no signing code and no order
# endpoint, so a key would have nothing to authenticate.

# ------------------------------------------------------------------- storage

# Empty means <data_dir>/aurum.db. The schema renders for PostgreSQL too, but
# the v1 driver is SQLite only.
AURUM_DB_URL=

# ------------------------------------------------------------------ research

AURUM_RESEARCH_ENABLED=true
# AURUM_SET__research__cycle_interval_s=45
# AURUM_SET__research__min_warmup_s=120

# --------------------------------------------------------------- exploration

# Trade on a timer with NO validated edge, to exercise the execution path.
# Off by default. The direction is a coin flip, so the expected result is a
# loss of about one round trip per trade (~11 bps) — that is the measurement,
# not a malfunction. Every signal it produces is tagged `exploration` so it can
# never be counted as evidence of an edge, and /health reports EXPLORATION.
#
# Sizing matters: at the default risk_per_trade_pct 250 trades/day costs about
# 9% of a 100 EUR wallet per day and trips the daily-loss breaker in about a
# day. See the README section "Exploration mode" for the arithmetic.
#
# AURUM_EXPLORATION=true
# AURUM_EXPLORATION_TRADES_PER_DAY=250
# AURUM_SET__exploration__risk_per_trade_pct=0.02
# AURUM_SET__exploration__hold_s=120
#
# Run it in its own database so it cannot end the clean run's 100 EUR cycle:
# AURUM_DATA_DIR=./data/exploration

# ---------------------------------------------------------- worked examples

# Replay a recorded or generated file at six times its original pace:
# AURUM_SET__market__feed=replay
# AURUM_SET__market__replay_path=./data/replay.jsonl
# AURUM_SET__market__replay_speed=6

# Watch the feed without doing any research:
# AURUM_RESEARCH_ENABLED=false

# ------------------------------------------------------------------ frontend

# Where the dashboard looks for the engine. Read at build time.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8002
