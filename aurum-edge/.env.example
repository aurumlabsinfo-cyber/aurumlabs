# AURUM EDGE 1.0 - copia questo file in .env e modificalo.
# Nessun valore qui è un segreto: le chiavi vere non vanno mai committate.

# ----------------------------------------------------------------- modalità
# paper (default) oppure live. LIVE richiede anche --i-understand-live.
AURUM_MODE=paper

# ------------------------------------------------------------------- Bybit
# Servono per LIVE e per il private stream. In PAPER si può lasciare vuoto:
# il sistema usa comunque il feed pubblico reale di Bybit.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
BYBIT_RECV_WINDOW_MS=5000

# ---------------------------------------------------------------- database
# L'unico database canonico. Path assoluto, condiviso da backend e CLI.
AURUM_DB_PATH=/var/lib/aurum-edge/aurum_edge.sqlite3

# --------------------------------------------------------------------- API
AURUM_API_HOST=0.0.0.0
AURUM_API_PORT=8100
# Se valorizzato, gli endpoint di controllo richiedono l'header X-Aurum-Token.
AURUM_API_TOKEN=

# -------------------------------------------------------------------- scan
AURUM_MIN_TURNOVER_24H=25000000
AURUM_MAX_SPREAD_BPS=8
AURUM_MAX_UNIVERSE=220
AURUM_FOCUS_SIZE=30
AURUM_SCAN_INTERVAL_S=0.25
AURUM_STALE_BOOK_MS=2500
AURUM_MAX_LATENCY_MS=1500

# ------------------------------------------------------ capitale e rischio
AURUM_PAPER_EQUITY_EUR=1000
AURUM_MARGIN_MIN_EUR=40
AURUM_MARGIN_MAX_EUR=60
AURUM_LEVERAGE=10
AURUM_RESERVE_FRACTION=0.35
AURUM_MAX_POSITIONS=6
AURUM_TARGET_NET_EUR=2.0
AURUM_MAX_LOSS_PER_TRADE_EUR=2.0
AURUM_DAILY_MAX_LOSS_EUR=40

# Allinea le fee al tuo tier VIP: cambiano direttamente quali trade sono
# possibili. 0.00055 = 0,055% per lato (taker standard).
AURUM_TAKER_FEE=0.00055
AURUM_MAKER_FEE=0.0002

# Tasso usato per riportare in EUR i valori in USDT.
AURUM_EUR_PER_USDT=1.0

# --------------------------------------------------------------- sicurezza
# Se questo file esiste, il sistema non apre nuove posizioni.
AURUM_KILL_SWITCH_FILE=/var/lib/aurum-edge/KILL

# ------------------------------------------------------------ apprendimento
AURUM_LEARN_ENABLED=true
AURUM_LEARN_INTERVAL_S=900
AURUM_LEARN_MIN_TRADES=120

# ------------------------------------------------------------------- log
AURUM_LOG_LEVEL=INFO
AURUM_LOG_JSON=false
# true = registra ogni singola valutazione, non solo i candidati in classifica.
AURUM_LOG_ALL_NO_TRADE=false
