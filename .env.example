# =============================================================================
# BTC 5-SECOND QUANT ENGINE - environment template
#
# Copy to .env and adjust. NEVER commit .env.
# No exchange API key is needed: every market-data endpoint used here is public.
# =============================================================================

# ------------------------------------------------------------------- runtime
ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------------ database
# Async driver for the app. docker-compose sets host=postgres automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/btcquant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=btcquant
DB_ECHO=false
DB_FLUSH_INTERVAL_MS=500
PERSIST_MARKET_TICKS=true
PERSIST_TRADES=true
PERSIST_FEATURES=true
PERSIST_BOOK_UPDATES=false    # very high volume; enable only for book research
BOOK_SNAPSHOT_INTERVAL_S=30
# How often a snapshot of paper-trading performance is written to
# `performance_metrics` (live trades only). 0 disables nothing - use a
# large value if you do not want the history.
PERFORMANCE_METRICS_INTERVAL_S=300

# ------------------------------------------------------------------ exchange
# Comma separated; the FIRST one is the primary price source.
# Available: binance_spot, binance_futures, coinbase, synthetic
# Add binance_futures to also collect funding / open interest / liquidations.
EXCHANGES=binance_spot
SYMBOL=BTCUSDT
TICK_SIZE=0.01

BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_REST_BASE=https://api.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
COINBASE_WS_BASE=wss://ws-feed.exchange.coinbase.com
COINBASE_REST_BASE=https://api.exchange.coinbase.com

# Route BOTH the REST calls and the WebSocket through an HTTP proxy. Leave it
# empty for a direct connection. Set it when your network cannot reach the
# venue: without it the engine connects to nothing, receives nothing, and
# correctly emits NO TRADE forever - GET /diagnostics will say NO MARKET DATA.
HTTP_PROXY_URL=

ORDERBOOK_DEPTH_LIMIT=1000
ORDERBOOK_STREAM_SPEED_MS=100
WS_STALE_TIMEOUT_S=10
REST_TIMEOUT_S=10

# The synthetic source emits MODEL-GENERATED data, not market data. It exists
# only so the pipeline can run offline (CI, tests, no connectivity). Everything
# it produces is flagged is_synthetic and excluded from edge research.
ALLOW_SYNTHETIC_SOURCE=false

# ------------------------------------------------------------ feature engine
FEATURE_INTERVAL_MS=100
TICK_BUFFER_SECONDS=300
TRADE_BUFFER_SECONDS=300
VOLATILITY_WINDOW_S=30

# --------------------------------------------------------------- data gating
# The engine refuses to trade when any of these is violated.
# Calibrated on real BTC (Crypto.com BTC_USDT, 2026-08-14): the quoted spread
# there is one tick, ~0.0016 bps. A 3 bps limit could never fire.
MAX_SPREAD_BPS=1.0
MAX_LATENCY_MS=750
MAX_FEED_GAP_MS=2000
MIN_DATA_QUALITY=0.75
MIN_WARMUP_SECONDS=60
# NO TRADE when this share of recent 5s windows had NO price change at all.
# Measured at 0.32 on real BTC: at this horizon a binary bet is largely a bet
# on the tie rule, so it is gated explicitly.
MAX_ZERO_MOVE_FRACTION=0.35
# The expected move must be worth at least this many ticks to be exploitable.
MIN_EXPECTED_MOVE_TICKS=2
# Top-of-book smaller than this notional is dust: on real data the touch is
# often ~$100 against ~$10,000, which pins L1 imbalance near +/-1 and makes it
# meaningless. Below it, the feature is reported as unavailable.
MIN_L1_NOTIONAL=500

# -------------------------------------------------------------------- signals
SIGNAL_ENABLED=true
# The prediction horizon, in seconds. 5 = the original 5-second engine,
# 900 = "up or down over the next 15 minutes".
#
# Changing this changes more than one number. Windows that depend on the
# horizon grow with it automatically unless you set them yourself:
# TICK_BUFFER_SECONDS and TRADE_BUFFER_SECONDS to 4x the horizon,
# VOLATILITY_WINDOW_S and ML_EMBARGO_S to 2x, SIGNAL_COOLDOWN_MS to 20%,
# SIGNAL_WAIT_TIMEOUT_S to 50%. Set any of them explicitly and your value wins.
#
# At 900 the microstructure features (order flow, L1 imbalance, 5s returns)
# describe the next few seconds, not the next fifteen minutes. The engine also
# computes minute-scale features - returns and volatility over 1m/5m/15m, where
# price sits in its recent range, and the fitted drift - which is what a
# minute-scale horizon can actually use.
SIGNAL_HORIZON_S=5.0

# Which decision path produces signals:
#   ensemble - the eight agents and their gates (the original behaviour)
#   burst15  - AURUM BURST-15: a 15-minute operating window that only takes
#              tape bursts on a 5-second horizon. See BURST15.md.
SIGNAL_STRATEGY=ensemble

# THE THREE GATES THAT DECIDE WHETHER ANYTHING IS EVER EMITTED.
#
# SIGNAL_MIN_AGREEMENT is how much of the outcome space the agents jointly
# claim (agreement x mean confidence) - a CONSENSUS measure.
# SIGNAL_MIN_CONFIDENCE / SIGNAL_MIN_EDGE describe the same thing from two
# sides: confidence is exactly 0.5 + edge, and the stricter of the two binds.
# Keep them consistent (0.55 <-> 0.05), or one of them does nothing.
#
# Raising these does not make the engine more accurate, only more selective.
# Check GET /shadow to see whether the windows a gate rejected would have won
# before you loosen or tighten anything.
SIGNAL_MIN_AGREEMENT=0.35
SIGNAL_MIN_CONFIDENCE=0.55
SIGNAL_MIN_EDGE=0.05
# The anomaly detector scores severity as (findings)/3. Hard findings (book
# desync, latency, data quality, price spike, abnormal spread) always veto;
# soft ones only once they stack past this.
ANOMALY_MAX_SEVERITY=0.5
SIGNAL_COOLDOWN_MS=3000
SIGNAL_MAX_CONCURRENT=1
SIGNAL_WAIT_TIMEOUT_S=30
TRIGGER_SIGMA_K=0.35
TRIGGER_MAX_BPS=8.0
TRIGGER_MIN_TICKS=1
TRIGGER_PRICE_SOURCE=mid      # mid | last | micro

# --------------------------------------------------------- AURUM BURST-15
# Only read when SIGNAL_STRATEGY=burst15. The trigger: at least N5 trades in
# the last 5 seconds, a 10-second move of at least R10 basis points, and order
# flow pointing the same way. Direction is the sign of that move. Entry is
# time-based (ENTRY_DELAY_MS after the trigger), not a price touch.
BURST_N5_MIN=40
BURST_R10_MIN_BPS=0.5
BURST_REQUIRE_OFI_AGREE=true
BURST_ENTRY_DELAY_MS=1000
# The operating window itself, and the risk rules that close it early.
BURST_SESSION_S=900
BURST_COOLDOWN_MS=6000
BURST_MAX_TRADES_SESSION=40
BURST_STOP_LOSS_UNITS=-6
BURST_TAKE_PROFIT_UNITS=15
BURST_MAX_STALENESS_MS=2000
BURST_MIN_DATA_QUALITY=0.75
BURST_AUTO_RESTART=true
# Used ONLY for the session stop-loss arithmetic when BINARY_PAYOUT is unset.
BURST_ASSUMED_PAYOUT=0.8

# -------------------------------------------------------------- paper trading
# Binary payout as a fraction (0.8 = +80% on a win, -100% on a loss).
# LEAVE EMPTY IF UNKNOWN: the system then reports PAYOUT UNKNOWN and refuses to
# state a monetary P&L. Break-even win rate = 1 / (1 + payout).
BINARY_PAYOUT=
PAPER_STAKE=1.0

# ------------------------------------------------------------------------ ml
MODEL_DIR=./models
ACTIVE_MODEL_ID=
ML_MIN_SAMPLES=5000
ML_EMBARGO_S=30

# ---------------------------------------------------------- learning on its own
# Re-runs the whole validated pipeline on a schedule and activates the result -
# but ONLY when the walk-forward edge classifies as PROVEN or PROMISING. A run
# that concludes NO ROBUST EDGE leaves the live engine exactly as it was.
# Nothing is learned from a single settled trade: that is how a system ends up
# chasing noise with growing confidence.
AUTO_RETRAIN_ENABLED=true
RETRAIN_INTERVAL_S=3600
RETRAIN_INITIAL_DELAY_S=900
RETRAIN_SPLITS=5
# Fit a probability calibrator on a purged hold-out tail. An uncalibrated model
# is blended into the live ensemble at 0.3 weight instead of 0.5.
CALIBRATE_MODELS=true

# Record the engine's lean on EVERY evaluated window, not only the ones that
# became signals - otherwise training data describes the engine's own filter
# rather than the market. GET /shadow scores them.
SHADOW_DECISIONS_ENABLED=true
SHADOW_DECISION_INTERVAL_MS=1000
# A NO TRADE window is evaluated 10x/s. One `signals` row for each of them is
# ~864k rows/day of "nothing happened"; this keeps a heartbeat instead.
NO_TRADE_ROW_INTERVAL_MS=5000

# ------------------------------------------------------------------ security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required for /settings, /models/activate, POST /backtest, /admin/*.
# Generate with: openssl rand -hex 32   -- keep it out of the frontend.
ADMIN_API_KEY=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_S=60
WS_MAX_CONNECTIONS=200

# ------------------------------------------------------------------ frontend
# NEXT_PUBLIC_* values are compiled into the browser bundle: never put a secret
# here. These are just the URLs of the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
