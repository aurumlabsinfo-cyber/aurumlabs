# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# python
# Not scoped to backend/: desktop/notifier.py is imported by the test suite,
# which left a desktop/__pycache__ that these rules had not covered.
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
backend/models/*.joblib
.coverage
htmlcov/

# Database locale del motore a file singolo
aurum.db
aurum.db-wal
aurum.db-shm
*.db

# AURUM EDGE: the canonical database never belongs in git
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.pytest_cache/
